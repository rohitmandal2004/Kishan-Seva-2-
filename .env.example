# ==============================================================
# Kishan Seva — Environment Variables
# ==============================================================
# Copy this file to .env and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard → Settings → API
# ==============================================================

# Supabase Project URL (e.g. https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous/Public Key (starts with "eyJ...")
VITE_SUPABASE_ANON_KEY=

# Clerk Authentication (Starts with "pk_...")
VITE_CLERK_PUBLISHABLE_KEY=

# Demo Mode (Set to false in production. When false, demo role switching and quick demo logins are disabled)
VITE_ENABLE_DEMO_MODE=false
