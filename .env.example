# ==============================================================
# Kishan Seva — Environment Variables
# ==============================================================
# Copy this file to .env and fill in your values.
# Get Supabase values from: https://supabase.com/dashboard → Settings → API
# Get Clerk values from: https://dashboard.clerk.com → API Keys
# ==============================================================

# Supabase Project URL (e.g. https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous/Public Key (starts with "eyJ..." or "sb_publishable_...")
VITE_SUPABASE_ANON_KEY=

# Clerk Authentication (Starts with "pk_...")
VITE_CLERK_PUBLISHABLE_KEY=

# Demo Mode (Set to false in production — disables demo role switching)
VITE_ENABLE_DEMO_MODE=false

# ML Service URL — set to your deployed FastAPI instance to enable ML predictions.
# If unset, the app uses the Supabase DB heuristic (always works without ML service).
# Deploy ml-service to Render/Railway/Fly.io free tier and paste the URL here.
# Example: https://kishan-ml.onrender.com
VITE_ML_SERVICE_URL=

# ─── SERVER-ONLY (never use VITE_ prefix — would be inlined into the client bundle) ───
# Supabase Service Role Key — used ONLY in server-side scripts (scripts/)
# NEVER commit this value. NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
