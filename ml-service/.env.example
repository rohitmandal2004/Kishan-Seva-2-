# ==============================================================
# Kishan Seva — ML Service Environment Variables
# ==============================================================
# Copy this file to .env and fill in your values.
# These are used by the FastAPI prediction service (ml-service/app/main.py)
# ==============================================================

# Supabase Project URL (same as the frontend's VITE_SUPABASE_URL)
VITE_SUPABASE_URL=

# Supabase Anonymous/Public Key (same as the frontend's VITE_SUPABASE_ANON_KEY)
VITE_SUPABASE_ANON_KEY=

# Port (optional — defaults to 8000; Render/Railway auto-set this)
PORT=8000
